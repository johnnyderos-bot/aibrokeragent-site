# Hedera
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=your_ecdsa_private_key
HEDERA_EVM_ADDRESS=0x...

# Database
DB_PATH=./vault.db

# Vault encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
VAULT_ENCRYPTION_KEY=your_64_char_hex_key

# Server
PORT=3000

# Admin — used for manual top-ups until mirror node verification is built
# Generate: node -e "console.log('adm1_' + require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=adm1_your_admin_key_here

# Telegram Analytics Bot (optional)
# Create a bot via @BotFather, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Vault Storage Backend (alpha: sqlite | closed beta+: storj)
# sqlite — encrypted blobs stored inline in DB (default, no extra deps)
# storj  — encrypted blobs uploaded to Storj decentralized S3 gateway
#           Add @aws-sdk/client-s3 to package.json before switching to storj
VAULT_STORAGE_BACKEND=sqlite

# Storj credentials (required only if VAULT_STORAGE_BACKEND=storj)
# Create access grant at https://storj.io → generate S3 credentials
# Apply for partner program at https://storj.io/partners to enable revenue share
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_ACCESS_KEY=your_storj_access_key
STORJ_SECRET_KEY=your_storj_secret_key
STORJ_BUCKET=brokeragent-vault
